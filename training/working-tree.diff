+def jump_action_rate_huber(
+    env: ManagerBasedRlEnv,
+    delta: float = 0.5,
+    max_error: float = 2.0,
+) -> torch.Tensor:
+    """Robust mean action-rate cost that cannot create an unbounded tax cliff."""
+    error = torch.clamp(
+        torch.abs(env.action_manager.action - env.action_manager.prev_action),
+        max=max_error,
+    )
+    quadratic = torch.minimum(error, torch.full_like(error, delta))
+    linear = error - quadratic
+    return (0.5 * quadratic.square() + delta * linear).mean(dim=-1)
+
+
+def jump_airborne_tilt_cost(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    quat = asset.data.root_link_quat_w
+    tilt = 2.0 * (quat[:, 1].square() + quat[:, 2].square())
+    airborne = env._jump_takeoff_latched & ~env._jump_landed_latched
+    return torch.nan_to_num(tilt, nan=0.0) * airborne.float()
+
