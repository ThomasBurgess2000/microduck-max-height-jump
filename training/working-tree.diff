+def _jump_recovery_score(
+    env: ManagerBasedRlEnv,
+    asset: Entity,
+    feet_cfg: SceneEntityCfg,
+    stand_height: float,
+) -> torch.Tensor:
+    quat = asset.data.root_link_quat_w
+    upright = torch.clamp(
+        torch.nan_to_num(1.0 - 2.0 * (quat[:, 1].square() + quat[:, 2].square()), nan=0.0),
+        min=0.0,
+        max=1.0,
+    )
+    z = torch.nan_to_num(
+        asset.data.root_link_pos_w[:, 2] - env.scene.terrain.env_origins[:, 2], nan=0.0
+    )
+    height = torch.clamp(z / max(stand_height, 1e-6), 0.0, 1.0)
+    feet_xy = asset.data.site_pos_w[:, feet_cfg.site_ids, :2].mean(dim=1)
+    com_dist = torch.norm(asset.data.root_com_pos_w[:, :2] - feet_xy, dim=-1)
+    centered = torch.exp(-((com_dist / 0.035) ** 2))
+    return upright * height * centered
+
+
+def _jump_qualified_takeoff_mask(
+    pre_takeoff: torch.Tensor,
+    support_latched: torch.Tensor,
+    any_ground: torch.Tensor,
+    body_contact: torch.Tensor,
+    com_vz: torch.Tensor,
+    cos_tilt: torch.Tensor,
+    takeoff_vz_min: float,
+    takeoff_tilt_max_deg: float,
+) -> torch.Tensor:
+    """Hard validity gate: launch must follow support established this episode."""
+    return (
+        pre_takeoff
+        & support_latched
+        & ~any_ground
+        & ~body_contact
+        & (com_vz >= takeoff_vz_min)
+        & (cos_tilt >= math.cos(math.radians(takeoff_tilt_max_deg)))
+    )
+
+
+def _jump_visible_takeoff_mask(
+    airborne: torch.Tensor,
+    descending_spawn: torch.Tensor,
+    valid_takeoff_latched: torch.Tensor,
+    clearance_steps: torch.Tensor,
+    airtime: torch.Tensor,
+    clearance_steps_min: int,
+    airtime_min: float,
+) -> torch.Tensor:
+    """Require sustained visible clearance rather than a one-frame contact gap."""
+    return (
+        airborne
+        & ~descending_spawn
+        & ~valid_takeoff_latched
+        & (clearance_steps >= max(1, clearance_steps_min))
+        & (airtime >= airtime_min)
+    )
+
+
+def _jump_effective_sole_clearance(
+    sole_height: torch.Tensor,
+    grounded_sole_height: torch.Tensor,
+    pre_takeoff: torch.Tensor,
+    both_grounded: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return gap above the last supported sole envelope and its new reference."""
+    grounded_sole_height = torch.where(
+        pre_takeoff & both_grounded,
+        sole_height,
+        grounded_sole_height,
+    )
+    return (
+        torch.clamp(sole_height - grounded_sole_height, min=0.0),
+        grounded_sole_height,
+    )
+
+
+def _jump_reset_stance_mask(
+    pose_rms: torch.Tensor,
+    head_max_error: torch.Tensor,
+    foot_distance: torch.Tensor,
+    pose_rms_max: float,
+    head_max_error_max: float,
+    foot_distance_min: float,
+) -> torch.Tensor:
+    """Whether a landed pose has genuinely returned to the HOME stance."""
+    return (
+        (pose_rms <= pose_rms_max)
+        & (head_max_error <= head_max_error_max)
+        & (foot_distance >= foot_distance_min)
+    )
+
+
+def _jump_reset_stance_errors(
+    env: ManagerBasedRlEnv,
+    asset: Entity,
+    feet_cfg: SceneEntityCfg,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return all-servo RMS, worst head-joint error, and foot-site spacing."""
+    error = _servo_joint_pos(env, asset) - _servo_default_joint_pos(env, asset)
+    pose_rms = torch.sqrt(torch.mean(error.square(), dim=-1) + 1e-8)
+    # Canonical servo layout: neck/head are indices 5:9. The servo-only view
+    # keeps these indices correct on backlash and other passive-joint models.
+    head_max_error = error[:, 5:9].abs().amax(dim=-1)
+    foot_xy = asset.data.site_pos_w[:, feet_cfg.site_ids, :2]
+    foot_distance = torch.norm(foot_xy[:, 0] - foot_xy[:, 1], dim=-1)
+    return pose_rms, head_max_error, foot_distance
+
+
+def _update_jump_state(
+    env: ManagerBasedRlEnv,
+    asset: Entity,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+    feet_sensor_name: str = _JUMP_FEET_SENSOR,
+    body_sensor_name: str = _JUMP_BODY_SENSOR,
+    takeoff_vz_min: float = 0.05,
+    takeoff_tilt_max_deg: float = 30.0,
+    min_grounded_steps: int = 4,
+    takeoff_clearance_min: float = 0.003,
+    takeoff_clearance_steps: int = 2,
+    takeoff_airtime_min: float = 0.08,
+    stable_time: float = 1.0,
+    stable_tilt_max_deg: float = 18.0,
+    stable_height_min: float = 0.085,
+    stable_lin_speed_max: float = 0.20,
+    stable_ang_speed_max: float = 1.5,
+    stable_com_foot_max: float = 0.035,
+    durable_pose_rms_max: float = JUMP_DURABLE_POSE_RMS_MAX_RAD,
+    durable_head_max_error: float = JUMP_DURABLE_HEAD_MAX_ERROR_RAD,
+    durable_foot_distance_min: float = JUMP_DURABLE_FOOT_DISTANCE_MIN_M,
+    stand_height: float = 0.115,
+) -> None:
+    """Advance the jump state machine once per control step.
+
+    Raw contact loss latches only after a two-foot support history and upward
+    whole-body motion.  A *valid* takeoff additionally requires the lowest
+    heel/toe corner across both soles to clear ``takeoff_clearance_min`` for
+    consecutive steps and remain airborne for ``takeoff_airtime_min``. Height
+    is the minimum of CoM rise and bilateral sole clearance. Landing is the
+    first later foot contact; settlement requires a quiet, centered two-foot
+    stance continuously for ``stable_time``.
+    """
+    _jump_state(env, asset)
+    step = int(env.common_step_counter)
+    if step == env._jump_last_update_step:
+        return
+
+    env._jump_takeoff_pulse.zero_()
+    env._jump_touchdown_pulse.zero_()
+    env._jump_stable_pulse.zero_()
+
+    contacts = _jump_contact_mask(env, feet_sensor_name)
+    if contacts.shape[1] >= 2:
+        both_grounded = contacts[:, :2].all(dim=-1)
+    else:
+        both_grounded = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
+    any_ground = contacts.any(dim=-1)
+    body_contact = _jump_contact_mask(env, body_sensor_name).any(dim=-1)
+
+    com_z = torch.nan_to_num(asset.data.root_com_pos_w[:, 2], nan=0.0)
+    com_vz = torch.nan_to_num((com_z - env._jump_prev_com_z) / env.step_dt, nan=0.0)
+    # The entity cache can be one sample behind immediately after a reset;
+    # root-link velocity is the safer fallback for that single step.
+    root_vz = torch.nan_to_num(asset.data.root_link_lin_vel_w[:, 2], nan=0.0)
+    com_vz = torch.where(env.episode_length_buf <= 1, root_vz, com_vz)
+    env._jump_com_vz = com_vz
+    env._jump_prev_com_z = com_z.clone()
+
+    quat = asset.data.root_link_quat_w
+    cos_tilt = torch.nan_to_num(
+        1.0 - 2.0 * (quat[:, 1].square() + quat[:, 2].square()), nan=-1.0
+    )
+    pre_takeoff = ~env._jump_takeoff_latched
+    # Record the uncapped physical launch frontier before the takeoff latch is
+    # flipped.  The v1 reward updated this only after latching, so the takeoff
+    # sample itself was lost and checkpoint evaluation misleadingly reported
+    # 0 m/s even for qualified contact loss.
+    grounded_steps = torch.where(
+        pre_takeoff & both_grounded,
+        env._jump_grounded_steps + 1,
+        torch.where(pre_takeoff, torch.zeros_like(env._jump_grounded_steps), env._jump_grounded_steps),
+    )
+    env._jump_grounded_steps = grounded_steps
+    support_ready = (
+        pre_takeoff
+        & ~env._jump_descending_spawn
+        & (grounded_steps >= min_grounded_steps)
+    )
+    new_support = support_ready & ~env._jump_support_latched
+    env._jump_support_latched |= support_ready
+    env._jump_support_latched_step = torch.where(
+        new_support,
+        env.episode_length_buf,
+        env._jump_support_latched_step,
+    )
+
+    # No launch velocity is credited until support has been established after
+    # this reset. This makes spawn motion and contact-resolution bounce worth 0.
+    launch_candidate = torch.where(
+        pre_takeoff & env._jump_support_latched,
+        torch.clamp(com_vz, min=0.0),
+        torch.zeros_like(com_vz),
+    )
+    env._jump_launch_frontier = torch.maximum(
+        env._jump_launch_frontier, launch_candidate
+    )
+    new_takeoff = _jump_qualified_takeoff_mask(
+        pre_takeoff,
+        env._jump_support_latched,
+        any_ground,
+        body_contact,
+        com_vz,
+        cos_tilt,
+        takeoff_vz_min,
+        takeoff_tilt_max_deg,
+    )
+    env._jump_takeoff_latched |= new_takeoff
+    env._jump_takeoff_height = torch.where(new_takeoff, com_z, env._jump_takeoff_height)
+
+    airborne = env._jump_takeoff_latched & ~env._jump_landed_latched & ~any_ground
+    env._jump_air_steps = torch.where(
+        airborne, env._jump_air_steps + 1, env._jump_air_steps
+    )
+    sole_height = _jump_bilateral_sole_clearance(env, asset)
+    # Mesh contacts have a pose-dependent effective skin: the curved sole may
+    # report support while sparse underside points are several millimetres
+    # above the mathematical plane.  Measure the visible gap from the last
+    # supported envelope instead of rewarding that contact offset.  This also
+    # makes standing on toe/heel worth exactly zero until both feet separate.
+    clearance, env._jump_grounded_sole_height = _jump_effective_sole_clearance(
+        sole_height,
+        env._jump_grounded_sole_height,
+        pre_takeoff,
+        both_grounded,
+    )
+    env._jump_clearance = clearance
+    clearance_ok = airborne & (clearance >= takeoff_clearance_min)
+    env._jump_clearance_steps = torch.where(
+        clearance_ok,
+        env._jump_clearance_steps + 1,
+        torch.where(
+            airborne,
+            torch.zeros_like(env._jump_clearance_steps),
+            env._jump_clearance_steps,
+        ),
+    )
+    airtime = env._jump_air_steps.float() * env.step_dt
+    new_valid_takeoff = _jump_visible_takeoff_mask(
+        airborne=airborne,
+        descending_spawn=env._jump_descending_spawn,
+        valid_takeoff_latched=env._jump_valid_takeoff_latched,
+        clearance_steps=env._jump_clearance_steps,
+        airtime=airtime,
+        clearance_steps_min=takeoff_clearance_steps,
+        airtime_min=takeoff_airtime_min,
+    )
+    env._jump_valid_takeoff_latched |= new_valid_takeoff
+    env._jump_takeoff_pulse |= new_valid_takeoff
+
+    standing_airborne = airborne & ~env._jump_descending_spawn
+    rise = torch.clamp(com_z - env._jump_takeoff_height, min=0.0)
+    env._jump_height_frontier = torch.where(
+        standing_airborne,
+        torch.maximum(env._jump_height_frontier, rise),
+        env._jump_height_frontier,
+    )
+    env._jump_clearance_frontier = torch.where(
+        standing_airborne,
+        torch.maximum(env._jump_clearance_frontier, clearance),
+        env._jump_clearance_frontier,
+    )
+    visible_height = torch.minimum(clearance, rise)
+    env._jump_visible_height_frontier = torch.where(
+        standing_airborne,
+        torch.maximum(env._jump_visible_height_frontier, visible_height),
+        env._jump_visible_height_frontier,
+    )
+    env._jump_airtime_frontier = torch.where(
+        standing_airborne,
+        torch.maximum(env._jump_airtime_frontier, airtime),
+        env._jump_airtime_frontier,
+    )
+
+    new_touchdown = (
+        env._jump_takeoff_latched
+        & ~env._jump_landed_latched
+        & (env._jump_air_steps > 0)
+        & any_ground
+    )
+    env._jump_landed_latched |= new_touchdown
+    env._jump_touchdown_pulse |= new_touchdown
+    env._jump_body_contact_latched |= body_contact & env._jump_valid_takeoff_latched
+    post_touchdown = env._jump_landed_latched
+    env._jump_post_touchdown_steps = torch.where(
+        post_touchdown,
+        env._jump_post_touchdown_steps + 1,
+        torch.zeros_like(env._jump_post_touchdown_steps),
+    )
+
+    feet_xy = asset.data.site_pos_w[:, feet_cfg.site_ids, :2].mean(dim=1)
+    com_dist = torch.norm(asset.data.root_com_pos_w[:, :2] - feet_xy, dim=-1)
+    lin_speed = torch.nan_to_num(asset.data.root_link_lin_vel_w, nan=0.0).norm(dim=-1)
+    touchdown_score = (
+        torch.exp(-((torch.clamp(-com_vz, min=0.0) / 0.35) ** 2))
+        * torch.exp(-((com_dist / 0.030) ** 2))
+        * torch.exp(-((torch.clamp(1.0 - cos_tilt, min=0.0) / 0.12) ** 2))
+        * torch.exp(-((lin_speed / 0.45) ** 2))
+        * (~body_contact).float()
+    )
+    env._jump_touchdown_score = torch.where(
+        new_touchdown, touchdown_score, env._jump_touchdown_score
+    )
+
+    recovery = _jump_recovery_score(env, asset, feet_cfg, stand_height)
+    env._jump_recovery_prev = torch.where(new_touchdown, recovery, env._jump_recovery_prev)
+
+    ang_speed = torch.nan_to_num(asset.data.root_link_ang_vel_b, nan=0.0).norm(dim=-1)
+    stable_now = (
+        env._jump_landed_latched
+        & both_grounded
+        & ~body_contact
+        & ~env._jump_body_contact_latched
+        & (cos_tilt >= math.cos(math.radians(stable_tilt_max_deg)))
+        & (asset.data.root_link_pos_w[:, 2] - env.scene.terrain.env_origins[:, 2] >= stable_height_min)
+        & (lin_speed <= stable_lin_speed_max)
+        & (ang_speed <= stable_ang_speed_max)
+        & (com_dist <= stable_com_foot_max)
+    )
+    env._jump_stable_steps = torch.where(
+        stable_now, env._jump_stable_steps + 1, torch.zeros_like(env._jump_stable_steps)
+    )
+    stable_steps_needed = max(1, int(math.ceil(stable_time / env.step_dt)))
+    new_stable = (
+        ~env._jump_stable_latched & (env._jump_stable_steps >= stable_steps_needed)
+    )
+    env._jump_stable_latched |= new_stable
+    env._jump_stable_pulse |= new_stable
+    pose_rms, head_max_error, foot_distance = _jump_reset_stance_errors(
+        env, asset, feet_cfg
+    )
+    reset_stance_now = _jump_reset_stance_mask(
+        pose_rms,
+        head_max_error,
+        foot_distance,
+        pose_rms_max=durable_pose_rms_max,
+        head_max_error_max=durable_head_max_error,
+        foot_distance_min=durable_foot_distance_min,
+    )
+    env._jump_reset_stance_now = reset_stance_now
+    env._jump_head_max_error = head_max_error
+    env._jump_foot_distance = foot_distance
+    at_horizon = env.episode_length_buf >= env.max_episode_length
+    env._jump_durable_success = (
+        at_horizon
+        & env._jump_valid_takeoff_latched
+        & env._jump_stable_latched
+        & stable_now
+        & reset_stance_now
+        & ~env._jump_body_contact_latched
+    )
+    env._jump_last_update_step = step
+
+
+def reset_jump_state(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor | None,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    standing_prob: float = 0.55,
+    crouch_prob: float = 0.25,
+    descending_prob: float = 0.20,
+    standing_z_range: tuple[float, float] = (0.112, 0.115),
+    crouch_z_range: tuple[float, float] = (0.068, 0.071),
+    descending_z_range: tuple[float, float] = (0.125, 0.150),
+    descending_vz_range: tuple[float, float] = (-0.35, -0.05),
+    tilt_max_deg: float = 5.0,
+    crouch_overrides: Optional[dict] = None,
+    joint_noise_std: float = 0.03,
+) -> None:
+    """Reset into standing, deep crouch, or descending reverse-curriculum states."""
+    if env_ids is None:
+        env_ids = torch.arange(env.num_envs, device=env.device)
+    if len(env_ids) == 0:
+        return
+    ids = env_ids.to(env.device, dtype=torch.long)
+    n = len(ids)
+    asset: Entity = env.scene[asset_cfg.name]
+    _jump_state(env, asset)
+
+    total = max(standing_prob + crouch_prob + descending_prob, 1e-6)
+    u = torch.rand(n, device=env.device) * total
+    is_crouch = (u >= standing_prob) & (u < standing_prob + crouch_prob)
+    is_desc = u >= standing_prob + crouch_prob
+
+    yaw = torch.rand(n, device=env.device) * 2.0 * math.pi - math.pi
+    pitch = (torch.rand(n, device=env.device) * 2.0 - 1.0) * math.radians(tilt_max_deg)
+    roll = (torch.rand(n, device=env.device) * 2.0 - 1.0) * math.radians(tilt_max_deg)
+    cy, sy = torch.cos(yaw / 2), torch.sin(yaw / 2)
+    cp, sp = torch.cos(pitch / 2), torch.sin(pitch / 2)
+    cr, sr = torch.cos(roll / 2), torch.sin(roll / 2)
+    quat = torch.stack(
+        [
+            cr * cp * cy + sr * sp * sy,
+            sr * cp * cy - cr * sp * sy,
+            cr * sp * cy + sr * cp * sy,
+            cr * cp * sy - sr * sp * cy,
+        ],
+        dim=1,
+    )
+    env.sim.data.qpos[ids, 3:7] = quat
+    env.sim.data.qvel[ids, :6] = 0.0
+
+    def sample_range(bounds: tuple[float, float]) -> torch.Tensor:
+        return torch.rand(n, device=env.device) * (bounds[1] - bounds[0]) + bounds[0]
+
+    z = sample_range(standing_z_range)
+    z = torch.where(is_crouch, sample_range(crouch_z_range), z)
+    z = torch.where(is_desc, sample_range(descending_z_range), z)
+    env.sim.data.qpos[ids, 2] = z
+    if is_desc.any():
+        desc_ids = ids[is_desc]
+        vz = (
+            torch.rand(len(desc_ids), device=env.device)
+            * (descending_vz_range[1] - descending_vz_range[0])
+            + descending_vz_range[0]
+        )
+        env.sim.data.qvel[desc_ids, 2] = vz
+
+    dynamic = is_crouch | is_desc
+    dynamic_ids = ids[dynamic]
+    if len(dynamic_ids) > 0 and crouch_overrides:
+        servo_ids = _servo_joint_ids(env, asset)
+        for servo_idx, target in crouch_overrides.items():
+            env.sim.data.qpos[dynamic_ids, 7 + servo_ids[servo_idx]] = target
+        if joint_noise_std > 0.0:
+            cols = torch.tensor([7 + j for j in servo_ids], device=env.device)
+            env.sim.data.qpos[dynamic_ids[:, None], cols[None, :]] += (
+                torch.randn(len(dynamic_ids), len(cols), device=env.device) * joint_noise_std
+            )
+
+    # Reset all state explicitly; descending spawns begin just after an
+    # artificial takeoff so they train touchdown/recovery without free launch pay.
+    for name in (
+        "_jump_takeoff_latched", "_jump_valid_takeoff_latched",
+        "_jump_support_latched", "_jump_body_contact_latched",
+        "_jump_landed_latched", "_jump_stable_latched",
+        "_jump_takeoff_pulse", "_jump_touchdown_pulse", "_jump_stable_pulse",
+        "_jump_durable_success",
+    ):
+        getattr(env, name)[ids] = False
+    for name in (
+        "_jump_grounded_steps",
+        "_jump_air_steps",
+        "_jump_clearance_steps",
+        "_jump_stable_steps",
+        "_jump_post_touchdown_steps",
+    ):
+        getattr(env, name)[ids] = 0
+    env._jump_support_latched_step[ids] = -1
+    for name in (
+        "_jump_takeoff_height", "_jump_launch_frontier", "_jump_launch_paid",
+        "_jump_height_frontier", "_jump_height_paid", "_jump_airtime_frontier",
+        "_jump_clearance", "_jump_grounded_sole_height", "_jump_clearance_frontier",
+        "_jump_visible_height_frontier", "_jump_visible_height_paid",
+        "_jump_airtime_paid", "_jump_recovery_prev", "_jump_settle_frontier",
+        "_jump_settle_paid", "_jump_com_vz",
+        "_jump_touchdown_score",
+    ):
+        getattr(env, name)[ids] = 0.0
+    env._jump_takeoff_latched[ids[is_desc]] = True
+    env._jump_descending_spawn[ids] = is_desc
+    env._jump_takeoff_height[ids[is_desc]] = z[is_desc] - 0.004
+    # qpos z is not whole-body CoM z. Mark the derivative uninitialized so the
+    # first state update uses measured root velocity rather than a false spike.
+    env._jump_prev_com_z[ids] = torch.nan
+    env._jump_last_update_step = -1
+
+
+def jump_launch_velocity_progress(
+    env: ManagerBasedRlEnv,
+    target_velocity: float = 0.25,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    frontier = torch.clamp(env._jump_launch_frontier, max=target_velocity)
+    delta = torch.clamp(frontier - env._jump_launch_paid, min=0.0)
+    env._jump_launch_paid = torch.maximum(env._jump_launch_paid, frontier)
+    return delta / (env.step_dt * max(target_velocity, 1e-6))
+
+
+def jump_takeoff_bonus(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    return env._jump_takeoff_pulse.float() / env.step_dt
+
+
+def jump_height_progress(
+    env: ManagerBasedRlEnv,
+    target_height: float = 0.005,
+    cap_at_target: bool = True,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    frontier = env._jump_height_frontier
+    if cap_at_target:
+        frontier = torch.clamp(frontier, max=target_height)
+    delta = torch.clamp(frontier - env._jump_height_paid, min=0.0)
+    env._jump_height_paid = torch.maximum(env._jump_height_paid, frontier)
+    return delta / (env.step_dt * max(target_height, 1e-6))
+
+
+def jump_visible_height_progress(
+    env: ManagerBasedRlEnv,
+    target_height: float = 0.015,
+    cap_at_target: bool = False,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Pay new max of min(CoM rise, bilateral underside clearance).
+
+    CoM-only height can be farmed by standing on the toes, while clearance-only
+    height can be farmed by tucking the legs. Their minimum advances only when
+    the entire robot follows both soles away from the floor.
+    """
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    frontier = env._jump_visible_height_frontier
+    if cap_at_target:
+        frontier = torch.clamp(frontier, max=target_height)
+    delta = torch.clamp(frontier - env._jump_visible_height_paid, min=0.0)
+    env._jump_visible_height_paid = torch.maximum(
+        env._jump_visible_height_paid, frontier
+    )
+    return delta / (env.step_dt * max(target_height, 1e-6))
+
+
+def jump_airtime_progress(
+    env: ManagerBasedRlEnv,
+    target_airtime: float = 0.06,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    frontier = torch.clamp(env._jump_airtime_frontier, max=target_airtime)
+    delta = torch.clamp(frontier - env._jump_airtime_paid, min=0.0)
+    env._jump_airtime_paid = torch.maximum(env._jump_airtime_paid, frontier)
+    return delta / (env.step_dt * max(target_airtime, 1e-6))
+
+
+def jump_touchdown_quality(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    return env._jump_touchdown_pulse.float() * env._jump_touchdown_score / env.step_dt
+
+
+def jump_recovery_progress(
+    env: ManagerBasedRlEnv,
+    stand_height: float = 0.115,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg, stand_height=stand_height)
+    score = _jump_recovery_score(env, asset, feet_cfg, stand_height)
+    active = env._jump_landed_latched & ~env._jump_stable_latched
+    delta = torch.where(active, score - env._jump_recovery_prev, torch.zeros_like(score))
+    env._jump_recovery_prev = torch.where(active, score, env._jump_recovery_prev)
+    return delta / env.step_dt
+
+
+def _jump_settle_score(
+    env: ManagerBasedRlEnv,
+    asset: Entity,
+    feet_cfg: SceneEntityCfg,
+    stand_height: float,
+) -> torch.Tensor:
+    """Broad, multiplicative landing quality score used as a paid-once frontier."""
+    quat = asset.data.root_link_quat_w
+    cos_tilt = torch.nan_to_num(
+        1.0 - 2.0 * (quat[:, 1].square() + quat[:, 2].square()), nan=-1.0
+    )
+    tilt_error = torch.clamp(1.0 - cos_tilt, min=0.0)
+    z = torch.nan_to_num(
+        asset.data.root_link_pos_w[:, 2] - env.scene.terrain.env_origins[:, 2], nan=0.0
+    )
+    feet_xy = asset.data.site_pos_w[:, feet_cfg.site_ids, :2].mean(dim=1)
+    com_dist = torch.norm(asset.data.root_com_pos_w[:, :2] - feet_xy, dim=-1)
+    lin_speed = torch.nan_to_num(asset.data.root_link_lin_vel_w, nan=0.0).norm(dim=-1)
+    ang_speed = torch.nan_to_num(asset.data.root_link_ang_vel_b, nan=0.0).norm(dim=-1)
+    joint_pos = _servo_joint_pos(env, asset)
+    target = _servo_default_joint_pos(env, asset)
+    pose_rms = torch.sqrt(torch.mean((joint_pos - target).square(), dim=-1) + 1e-8)
+    joint_speed = torch.sqrt(
+        torch.mean(torch.nan_to_num(_servo_joint_vel(env, asset), nan=0.0).square(), dim=-1)
+        + 1e-8
+    )
+    body_clear = ~_jump_contact_mask(env, _JUMP_BODY_SENSOR).any(dim=-1)
+    return (
+        torch.exp(-((tilt_error / 0.22) ** 2))
+        * torch.exp(-(((z - stand_height) / 0.040) ** 2))
+        * torch.exp(-((com_dist / 0.050) ** 2))
+        * torch.exp(-((lin_speed / 0.45) ** 2))
+        * torch.exp(-((ang_speed / 3.0) ** 2))
+        * torch.exp(-((pose_rms / 0.80) ** 2))
+        * torch.exp(-((joint_speed / 4.0) ** 2))
+        * body_clear.float()
+    )
+
+
+def jump_settle_progress(
+    env: ManagerBasedRlEnv,
+    stand_height: float = 0.115,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Pay only new best post-touchdown settling quality (unfarmable potential)."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg, stand_height=stand_height)
+    score = _jump_settle_score(env, asset, feet_cfg, stand_height)
+    # Keep improving after the broad physical-stability latch. That latch does
+    # not imply a forward head or HOME stance; stopping here let V5 twist its
+    # head and collapse its feet while still collecting the durable jackpot.
+    active = env._jump_landed_latched & ~env._jump_durable_success
+    env._jump_settle_frontier = torch.where(
+        active,
+        torch.maximum(env._jump_settle_frontier, score),
+        env._jump_settle_frontier,
+    )
+    delta = torch.clamp(env._jump_settle_frontier - env._jump_settle_paid, min=0.0)
+    env._jump_settle_paid = torch.maximum(env._jump_settle_paid, env._jump_settle_frontier)
+    return delta / env.step_dt
+
+
+def jump_post_touchdown_pose_cost(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """HOME-pose error only after touchdown; it cannot block launch exploration."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    active = env._jump_landed_latched
+    error = (
+        _servo_joint_pos(env, asset) - _servo_default_joint_pos(env, asset)
+    ).square().mean(dim=-1)
+    return error * active.float()
+
+
+def jump_post_touchdown_head_pose_cost(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Explicit forward-head cost for the full post-touchdown interval."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    error = (
+        _servo_joint_pos(env, asset)[:, 5:9]
+        - _servo_default_joint_pos(env, asset)[:, 5:9]
+    )
+    return error.square().mean(dim=-1) * env._jump_landed_latched.float()
+
+
+def jump_post_touchdown_stance_width_cost(
+    env: ManagerBasedRlEnv,
+    min_distance: float = 0.070,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Normalized foot-spacing shortfall after touchdown (zero near HOME)."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    foot_xy = asset.data.site_pos_w[:, feet_cfg.site_ids, :2]
+    distance = torch.norm(foot_xy[:, 0] - foot_xy[:, 1], dim=-1)
+    shortfall = torch.clamp(min_distance - distance, min=0.0) / max(min_distance, 1e-6)
+    return shortfall.square() * env._jump_landed_latched.float()
+
+
+def jump_post_touchdown_motion_cost(
+    env: ManagerBasedRlEnv,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Whole-body and joint motion cost for the full post-touchdown interval."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    active = env._jump_landed_latched
+    lin = torch.nan_to_num(asset.data.root_link_lin_vel_w, nan=0.0).square().sum(dim=-1)
+    ang = torch.nan_to_num(asset.data.root_link_ang_vel_b, nan=0.0).square().sum(dim=-1)
+    joint = torch.nan_to_num(_servo_joint_vel(env, asset), nan=0.0).square().mean(dim=-1)
+    return (lin + 0.05 * ang + 0.01 * joint) * active.float()
+
+
+def jump_failed_recovery(
+    env: ManagerBasedRlEnv,
+    recovery_timeout: float = 0.80,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """End a landing that hits the body or misses its recovery window."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    limit = max(1, int(math.ceil(recovery_timeout / env.step_dt)))
+    timed_out = (
+        env._jump_landed_latched
+        & ~env._jump_stable_latched
+        & (env._jump_post_touchdown_steps >= limit)
+    )
+    body_failure = (
+        env._jump_valid_takeoff_latched & env._jump_body_contact_latched
+    )
+    return timed_out | body_failure
+
+
+def jump_failed_recovery_cost(
+    env: ManagerBasedRlEnv,
+    recovery_timeout: float = 0.80,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """One-time episode-mass cost paired with ``jump_failed_recovery``."""
+    return jump_failed_recovery(
+        env,
+        recovery_timeout=recovery_timeout,
+        asset_cfg=asset_cfg,
+        feet_cfg=feet_cfg,
+    ).float() / env.step_dt
+
