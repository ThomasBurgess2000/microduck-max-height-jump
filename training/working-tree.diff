+    _update_jump_state(env, asset, feet_cfg)
+    airborne = env._jump_takeoff_latched & ~env._jump_landed_latched
+    return torch.nan_to_num(asset.data.root_link_lin_vel_w[:, :2], nan=0.0).square().sum(dim=-1) * airborne.float()
+
