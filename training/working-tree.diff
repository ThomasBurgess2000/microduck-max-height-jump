+def jump_stable_height_bonus(
+    env: ManagerBasedRlEnv,
+    target_height: float = 0.0065,
+    cap_at_target: bool = True,
+    log_scale: bool = False,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Confirm attained jump height only when a valid launch lands stably."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    height_fraction = torch.clamp(
+        env._jump_height_frontier / max(target_height, 1e-6), min=0.0
+    )
+    if log_scale:
+        height_fraction = torch.log1p(height_fraction)
+    elif cap_at_target:
+        height_fraction = torch.clamp(height_fraction, max=1.0)
+    valid = env._jump_valid_takeoff_latched & env._jump_stable_pulse
+    return valid.float() * height_fraction / env.step_dt
