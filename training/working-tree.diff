+def _jump_v4_spawn_mix(recovery_rate: float) -> tuple[float, float, float]:
+    if recovery_rate < 0.20:
+        return (0.35, 0.35, 0.30)
+    if recovery_rate < 0.50:
+        return (0.50, 0.40, 0.10)
+    return (0.65, 0.35, 0.0)
+
+
+def _jump_v4_action_weight(stable_jump_rate: float) -> float:
+    if stable_jump_rate < 0.02:
+        return 0.0
+    if stable_jump_rate < 0.10:
+        return -0.005
+    if stable_jump_rate < 0.25:
+        return -0.01
+    return -0.02
+
+
+def _jump_v4_dr_range(stable_jump_rate: float, max_range: float) -> float:
+    if stable_jump_rate < 0.05:
+        return min(0.003, max_range)
+    if stable_jump_rate < 0.15:
+        return min(0.005, max_range)
+    if stable_jump_rate < 0.30:
+        return min(0.010, max_range)
+    return max_range
+
+
+def _update_jump_v4_curriculum_stats(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    decay: float = 0.98,
+) -> tuple[float, float]:
+    """Update reset-batch EMAs once, before the corresponding state reset."""
+    step = int(env.common_step_counter)
+    if getattr(env, "_jump_v4_curriculum_step", -1) == step:
+        return env._jump_v4_recovery_rate, env._jump_v4_stable_jump_rate
+
+    env._jump_v4_curriculum_step = step
+    if not hasattr(env, "_jump_v4_recovery_rate"):
+        env._jump_v4_recovery_rate = 0.0
+        env._jump_v4_stable_jump_rate = 0.0
+    if not hasattr(env, "_jump_stable_latched") or env_ids is None or len(env_ids) == 0:
+        return env._jump_v4_recovery_rate, env._jump_v4_stable_jump_rate
+
+    ids = env_ids.to(env.device, dtype=torch.long)
+    completed = env.episode_length_buf[ids] > 0
+    desc = env._jump_descending_spawn[ids] & completed
+    jump = ~env._jump_descending_spawn[ids] & completed
+    if desc.any():
+        batch = env._jump_stable_latched[ids][desc].float().mean().item()
+        env._jump_v4_recovery_rate = decay * env._jump_v4_recovery_rate + (1.0 - decay) * batch
+    if jump.any():
+        success = (
+            env._jump_stable_latched[ids]
+            & env._jump_valid_takeoff_latched[ids]
+        )
+        batch = success[jump].float().mean().item()
+        env._jump_v4_stable_jump_rate = (
+            decay * env._jump_v4_stable_jump_rate + (1.0 - decay) * batch
+        )
+    return env._jump_v4_recovery_rate, env._jump_v4_stable_jump_rate
+
+
+def jump_spawn_performance_curriculum(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    event_name: str,
+) -> torch.Tensor:
+    recovery_rate, _ = _update_jump_v4_curriculum_stats(env, env_ids)
+    standing, crouch, descending = _jump_v4_spawn_mix(recovery_rate)
+    term_cfg = env.event_manager.get_term_cfg(event_name)
+    term_cfg.params.update(
+        standing_prob=standing,
+        crouch_prob=crouch,
+        descending_prob=descending,
+    )
+    return torch.tensor(descending, device=env.device)
+
+
+def jump_action_performance_curriculum(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    reward_name: str,
+) -> torch.Tensor:
+    _, stable_jump_rate = _update_jump_v4_curriculum_stats(env, env_ids)
+    weight = _jump_v4_action_weight(stable_jump_rate)
+    term_cfg = env.reward_manager.get_term_cfg(reward_name)
+    term_cfg.weight = weight
+    return torch.tensor(weight, device=env.device)
+
+
+def jump_dr_performance_curriculum(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    event_name: str,
+    max_range: float,
+) -> torch.Tensor:
+    _, stable_jump_rate = _update_jump_v4_curriculum_stats(env, env_ids)
+    value = _jump_v4_dr_range(stable_jump_rate, max_range)
+    term_cfg = env.event_manager.get_term_cfg(event_name)
+    term_cfg.params["ranges"] = (-value, value)
+    return torch.tensor(value, device=env.device)
+
+
+def reward_param_curriculum(
+    env: ManagerBasedRlEnv,
+    env_ids: torch.Tensor,
+    reward_name: str,
+    param_stages: list[dict],
+) -> torch.Tensor:
+    """Step-stage arbitrary params on a live reward term configuration."""
+    del env_ids
+    term_cfg = env.reward_manager.get_term_cfg(reward_name)
+    current = param_stages[0]["params"]
+    for stage in param_stages:
+        if env.common_step_counter >= stage["step"]:
+            current = stage["params"]
+    term_cfg.params.update(current)
+    first = next(iter(current.values()))
+    return torch.tensor(float(first) if isinstance(first, (int, float)) else 0.0)
