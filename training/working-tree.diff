+def _jump_contact_mask(env: ManagerBasedRlEnv, sensor_name: str) -> torch.Tensor:
+    """Return per-primary contact flags as ``(num_envs, num_primaries)``."""
+    if sensor_name not in env.scene.sensors:
+        return torch.zeros((env.num_envs, 1), dtype=torch.bool, device=env.device)
+    found = env.scene.sensors[sensor_name].data.found
+    if found.dim() == 1:
+        found = found[:, None]
+    elif found.dim() > 2:
+        found = found.view(found.shape[0], found.shape[1], -1).any(dim=-1)
+    return found.bool()
+
