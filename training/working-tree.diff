+def jump_durable_visible_height_bonus(
+    env: ManagerBasedRlEnv,
+    target_height: float = 0.015,
+    log_scale: bool = True,
+    asset_cfg: SceneEntityCfg = _DEFAULT_ASSET_CFG,
+    feet_cfg: SceneEntityCfg = _JUMP_FEET_CFG,
+) -> torch.Tensor:
+    """Confirm visible height only after a full-horizon quiet landing."""
+    asset: Entity = env.scene[asset_cfg.name]
+    _update_jump_state(env, asset, feet_cfg)
+    fraction = torch.clamp(
+        env._jump_visible_height_frontier / max(target_height, 1e-6), min=0.0
+    )
+    if log_scale:
+        fraction = torch.log1p(fraction)
+    return env._jump_durable_success.float() * fraction / env.step_dt
