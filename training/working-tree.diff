+def _jump_bilateral_sole_clearance(
+    env: ManagerBasedRlEnv,
+    asset: Entity,
+) -> torch.Tensor:
+    """Lowest underside-probe height shared by both feet above flat terrain.
+
+    Taking the minimum over the collision mesh's longitudinal lower envelope
+    on both soles makes toe rocking, heel lifting, and one-foot hops score zero
+    until the complete support polygon is visibly clear of the floor.  Sites
+    are reward-only and do not change the 61D policy observation.
+    """
+    if not hasattr(env, "_jump_sole_probe_ids"):
+        ids, names = asset.find_sites(_JUMP_SOLE_PROBE_NAMES, preserve_order=True)
+        if tuple(names) != _JUMP_SOLE_PROBE_NAMES:
+            raise RuntimeError(
+                f"jump sole probes resolved out of order: {tuple(names)!r}"
+            )
+        env._jump_sole_probe_ids = torch.tensor(
+            ids, dtype=torch.long, device=env.device
+        )
+    probe_z = asset.data.site_pos_w[:, env._jump_sole_probe_ids, 2]
+    ground_z = env.scene.terrain.env_origins[:, 2:3]
+    clearance = (probe_z - ground_z).view(env.num_envs, 2, -1)
+    per_foot = clearance.amin(dim=-1)
+    return torch.clamp(per_foot.amin(dim=-1), min=0.0)
+
+
+class JumpOneShotCommand(UniformVelocityCommand):
+    """One-shot jump request carried in the existing 3D twist command slot.
+
+    ``command[:, 0]`` is 1 while the policy should launch and 0 while it should
+    settle.  It drops after the first touchdown (or after ``launch_window_s``)
+    and is always zero for descending reverse-curriculum spawns.  This preserves
+    the shared 61D observation contract while removing the otherwise ambiguous
+    observation where the same standing pose means both "jump" at episode start
+    and "stay still" after landing.
+
+    Deployment writes the same one-shot 1 -> 0 flag into the twist-vx slot.
+    The remaining twist dimensions stay zero.
+    """
+
+    def __init__(self, cfg, env: ManagerBasedRlEnv):
+        super().__init__(cfg, env)
+        self._env_ref = env
+        self._launch_window_s = float(getattr(cfg, "launch_window_s", 0.75))
+
+    @property
+    def command(self) -> torch.Tensor:
+        return self.vel_command_b
+
+    def _resample_command(self, env_ids: torch.Tensor) -> None:
+        self.vel_command_b[env_ids] = 0.0
+        self.vel_command_b[env_ids, 0] = 1.0
+
+    def compute(self, dt: float) -> None:
+        del dt
+        descending = getattr(
+            self._env_ref,
+            "_jump_descending_spawn",
+            torch.zeros(self.num_envs, dtype=torch.bool, device=self.device),
+        )
+        landed = getattr(
+            self._env_ref,
+            "_jump_landed_latched",
+            torch.zeros(self.num_envs, dtype=torch.bool, device=self.device),
+        )
+        supported = getattr(
+            self._env_ref,
+            "_jump_support_latched",
+            torch.zeros(self.num_envs, dtype=torch.bool, device=self.device),
+        )
+        support_step = getattr(
+            self._env_ref,
+            "_jump_support_latched_step",
+            torch.full((self.num_envs,), -1, dtype=torch.long, device=self.device),
+        )
+        elapsed_since_support = (
+            self._env_ref.episode_length_buf - support_step
+        ).clamp(min=0).float() * self._env_ref.step_dt
+        launch = (
+            supported
+            & (elapsed_since_support < self._launch_window_s)
+            & ~descending
+            & ~landed
+        )
+        self.vel_command_b.zero_()
+        self.vel_command_b[:, 0] = launch.float()
+
+    def _update_command(self) -> None:
+        pass
+
+    def _update_metrics(self) -> None:
+        pass
+
+
